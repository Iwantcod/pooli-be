<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pooli.policy.mapper.PolicyBackOfficeMapper">

   <select id="selectActivePolicies"
            resultType="com.pooli.policy.domain.dto.response.ActivePolicyResDto">

         SELECT
	        policy_id AS policyId,
	        policy_category_id AS policyType,
	        policy_name,
	        is_new AS isNew
	    FROM POLICY
		    WHERE is_active = true
		      AND policy_id != 8

	    </select>

    <!-- 
        정책 전역 활성화 bootstrap/reconciliation용 스냅샷 조회 
        ※ policy_id = 8 (장애 복구 전역 플래그)은 복구 프로세스가 Redis에서 동적으로 관리하므로, 
           DB 스냅샷 동기화 시 덮어쓰여져 정합성이 오염되는 것을 방지하기 위해 제외합니다.
    -->
    <select id="selectPolicyActivationSnapshot"
            resultType="com.pooli.policy.domain.dto.response.PolicyActivationSnapshotResDto">
        SELECT
            policy_id AS policyId,
            is_active AS isActive,
            created_at AS createdAt,
            updated_at AS updatedAt
        FROM POLICY
        WHERE policy_id != 8
        ORDER BY policy_id ASC
    </select>
	    
</mapper>
