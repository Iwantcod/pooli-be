<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pooli.traffic.mapper.TrafficRestoreDailyAppTargetMapper">

    <!-- RESTORE_DAILY_APP_TARGET row를 Java target 객체로 변환한다. -->
    <resultMap id="TrafficRestoreDailyAppTargetResultMap" type="com.pooli.traffic.domain.restore.TrafficRestoreDailyAppTarget">
        <id property="id" column="id"/>
        <result property="batchName" column="batch_name"/>
        <result property="usageDate" column="usage_date"/>
        <result property="lineId" column="line_id"/>
        <result property="applicationId" column="application_id"/>
        <result property="status" column="status"/>
        <result property="statusUpdatedAt" column="status_updated_at"/>
        <result property="workerId" column="worker_id"/>
        <result property="retryCount" column="retry_count"/>
        <result property="lastErrorCode" column="last_error_code"/>
        <result property="lastErrorMessage" column="last_error_message"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- phase 완료 판단을 위해 DONE이 아닌 target row 수를 조회한다. -->
    <select id="countNotDoneTargets" resultType="long">
        SELECT COUNT(*)
        FROM RESTORE_DAILY_APP_TARGET
        WHERE batch_name = #{batchName}
          AND status != 'DONE'
    </select>

    <!-- phase 전환 금지를 위해 FAILED target row 수를 조회한다. -->
    <select id="countFailedTargets" resultType="long">
        SELECT COUNT(*)
        FROM RESTORE_DAILY_APP_TARGET
        WHERE batch_name = #{batchName}
          AND status = 'FAILED'
    </select>

    <!-- worker가 PENDING/RETRYABLE 및 lease timeout이 지난 PROCESSING row를 잠금 선점한다. -->
    <select id="selectClaimableTargetsForUpdate" resultMap="TrafficRestoreDailyAppTargetResultMap">
        SELECT
            id,
            batch_name,
            usage_date,
            line_id,
            application_id,
            status,
            status_updated_at,
            worker_id,
            retry_count,
            last_error_code,
            last_error_message,
            created_at
        FROM RESTORE_DAILY_APP_TARGET
        WHERE batch_name = #{batchName}
          AND (
              status IN ('PENDING', 'RETRYABLE')
              OR (status = 'PROCESSING' AND status_updated_at &lt; #{leaseExpiredBefore})
          )
        ORDER BY id
        LIMIT #{limit}
        FOR UPDATE SKIP LOCKED
    </select>

    <!-- 잠금 조회한 row만 PROCESSING으로 전환한다. -->
    <update id="markTargetsProcessing">
        UPDATE RESTORE_DAILY_APP_TARGET
        SET status = 'PROCESSING',
            status_updated_at = CURRENT_TIMESTAMP(6),
            worker_id = #{workerId}
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
          AND status IN ('PENDING', 'RETRYABLE', 'PROCESSING')
    </update>

    <!-- 현재 worker가 PROCESSING으로 보유한 row만 terminal 상태로 전환한다. -->
    <update id="markTargetTerminalIfProcessing">
        UPDATE RESTORE_DAILY_APP_TARGET
        SET status = #{status},
            status_updated_at = CURRENT_TIMESTAMP(6)
        WHERE id = #{id}
          AND status = 'PROCESSING'
          AND worker_id = #{workerId}
    </update>

</mapper>
